{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Research",
  "type": "object",
  "required": [
    "address",
    "sources",
    "observations",
    "unknowns"
  ],
  "properties": {
    "address": {
      "type": "string"
    },
    "sources": {
      "type": "array"
    },
    "observations": {
      "type": "array"
    },
    "confidence": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "context_for_rendering": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    }
  }
}
